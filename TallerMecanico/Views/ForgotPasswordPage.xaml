<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TallerMecanico.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Recuperar Contraseña"
    Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <!-- mensaje de instrucciones -->
            <Label Text="Restablecer Contraseña" FontSize="22" FontAttributes="Bold" TextColor="#2563EB" />
            <Label Text="Ingresa tu usuario y define tu nueva contraseña (máx 6 caracteres):" TextColor="Gray" />
            <Entry x:Name="TxtUserRecup" Placeholder="Nombre de Usuario" />
            <Entry x:Name="TxtNuevaPass" Placeholder="Nueva Contraseña (Máx 6)" MaxLength="6" IsPassword="True" />
            <Button Text="Actualizar Contraseña" BackgroundColor="#2563EB" TextColor="White" HeightRequest="50" CornerRadius="8" Clicked="OnResetClicked" />
            <Button Text="Volver" BackgroundColor="Transparent" TextColor="Gray" Clicked="OnBackClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>