<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TallerMecanico.Views.AdminVentaRepuestosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Venta de Repuestos"
    Shell.NavBarIsVisible="True">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- 1. Barra de Búsqueda -->
        <SearchBar Grid.Row="0" x:Name="SbVentaRepuestos" Placeholder="Buscar repuesto por nombre..." 
                   Margin="15,5" TextChanged="OnBuscarVentaChanged" />

        <!-- 2. Lista de Repuestos (sin RefreshView que bloquee la altura inicial) -->
        <CollectionView Grid.Row="1" x:Name="CvVentaRepuestos" Margin="15,0,15,10">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40,0,0">
                    <Label Text="📦" FontSize="36" HorizontalOptions="Center" />
                    <Label Text="No hay repuestos con stock disponible." TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="12" BorderColor="#CBD5E1" CornerRadius="10">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding StockDisponible, StringFormat='Stock en Taller: {0} un.'}" TextColor="#475569" FontSize="12" />
                                <Label Text="{Binding PrecioUnitario, StringFormat='Precio Unitario: ${0:N2}'}" TextColor="#16A34A" FontAttributes="Bold" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- Entrada de Cantidad a Vender -->
                            <HorizontalStackLayout Grid.Column="1" Grid.Row="0" VerticalOptions="Center" Spacing="6">
                                <Label Text="Cant:" VerticalOptions="Center" FontAttributes="Bold" />
                                <Entry Text="{Binding CantidadVenta, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" HorizontalTextAlignment="Center" TextChanged="OnCantidadChanged" />
                            </HorizontalStackLayout>

                            <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Subtotal, StringFormat='Subtotal: ${0:N2}'}" 
                                   TextColor="#0F766E" FontAttributes="Bold" HorizontalOptions="End" Margin="0,5,0,0" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. Barra Inferior: Total y Botón Vender -->
        <Frame Grid.Row="2" BackgroundColor="#1E293B" Padding="20,15" CornerRadius="0" HasShadow="True">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Total a Cobrar:" TextColor="#94A3B8" FontSize="12" />
                    <Label x:Name="LblTotalVenta" Text="$0.00" TextColor="#4ADE80" FontSize="22" FontAttributes="Bold" />
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="💰 Realizar Venta" BackgroundColor="#16A34A" TextColor="White" 
                        FontAttributes="Bold" HeightRequest="48" CornerRadius="8" Padding="20,0" Clicked="OnRealizarVentaClicked" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>