<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TallerMecanico.Views.AdminDetalleTurnoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Gestión de Turno"
    Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- datos del cliente -->
            <Frame BackgroundColor="#F1F5F9" Padding="12" CornerRadius="8">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="LblVehiculo" FontAttributes="Bold" FontSize="18" />
                    <Label x:Name="LblCliente" TextColor="#475569" />
                    <Label x:Name="LblTipoYFecha" FontAttributes="Bold" TextColor="#0F766E" />
                    <Label x:Name="LblProblema" TextColor="#334155" />
                </VerticalStackLayout>
            </Frame>
            <!--acciones de turno -->
            <VerticalStackLayout x:Name="PanelAccionesTurno" Spacing="8">
                <Label Text="Acciones de Turno" FontAttributes="Bold" TextColor="#1E293B" />
                <Grid x:Name="GridBotonesAccion" ColumnSpacing="8">
                    <!-- si es solicitado 3 columnas que son las de aceptar , reprogramar, cancelar -->
                    <!-- si fue aceptado 2 columnas que son las de reprogramar, cancelar -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnAceptarTurno" Grid.Column="0" Text=" Aceptar" BackgroundColor="#16A34A" TextColor="White" 
                            CornerRadius="8" FontSize="12" FontAttributes="Bold" HeightRequest="44"
                            Clicked="OnAceptarTurnoClicked" />
                    <Button x:Name="BtnReprogramarTurno" Grid.Column="1" Text="Reprogramar" BackgroundColor="#9333EA" TextColor="White" 
                            CornerRadius="8" FontSize="11" FontAttributes="Bold" HeightRequest="44"
                            Clicked="OnReprogramarClicked" />
                    <Button x:Name="BtnCancelarTurno" Grid.Column="2" Text="Cancelar" BackgroundColor="#DC2626" TextColor="White" 
                            CornerRadius="8" FontSize="12" FontAttributes="Bold" HeightRequest="44"
                            Clicked="OnCancelarTurnoClicked" />
                </Grid>
            </VerticalStackLayout>
            <!-- panel de reprogramación que esta inicialmente oculto -->
            <Frame x:Name="FrameReprogramar" IsVisible="False" BackgroundColor="#FAF5FF" BorderColor="#C084FC" CornerRadius="8" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nueva fecha para el turno:" FontAttributes="Bold" TextColor="#6B21A8" />
                    <DatePicker x:Name="DpNuevaFecha" Format="dd/MM/yyyy" />
                    <Button Text="Confirmar Reprogramación" BackgroundColor="#9333EA" TextColor="White" Clicked="OnConfirmarReprogramacionClicked" />
                </VerticalStackLayout>
            </Frame>
            <!-- estado del turno -->
            <Label Text="Estado Actual" FontAttributes="Bold" />
            <Picker x:Name="PickerEstado">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Solicitado</x:String>
                        <x:String>Aceptado</x:String>
                        <x:String>Reprogramado</x:String>
                        <x:String>En Proceso</x:String>
                        <x:String>Finalizado</x:String>
                        <x:String>Cancelado</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <!-- fecha estimada de entrega -->
            <Label Text="Fecha Estimada de Entrega al Cliente" FontAttributes="Bold" />
            <DatePicker x:Name="DpFechaEstimadaEntrega" Format="dd/MM/yyyy" />
            <!-- próximo service si es que esta habilitado  -->
            <VerticalStackLayout x:Name="PanelProximoService" IsVisible="False" Spacing="4">
                <Label Text="Fecha del Próximo Service Recomendado" FontAttributes="Bold" TextColor="#0F766E" />
                <DatePicker x:Name="DpProximoService" Format="dd/MM/yyyy" />
            </VerticalStackLayout>
            <Label Text="Diagnóstico Técnico" FontAttributes="Bold" />
            <Editor x:Name="TxtDiagnostico" Placeholder="Diagnóstico del taller..." AutoSize="TextChanges" HeightRequest="80" />
            <Label Text="Mano de Obra ($)" FontAttributes="Bold" />
            <Entry x:Name="TxtManoObra" Keyboard="Numeric" Text="0" TextChanged="OnManoObraChanged" />
            <Line BackgroundColor="#CBD5E1" HeightRequest="1" />
            <!-- aca esta la asignacion de repuestos -->
            <Label Text="Asignar Repuesto del Catálogo" FontAttributes="Bold" FontSize="16" />
            <Picker x:Name="PickerRepuestos" ItemDisplayBinding="{Binding Nombre}" Title="Selecciona un repuesto" />
            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="TxtCantidadRepuesto" Text="1" Keyboard="Numeric" WidthRequest="80" Placeholder="Cant." />
                <Button Text="Agregar Repuesto" BackgroundColor="#0F766E" TextColor="White" Clicked="OnAgregarRepuestoClicked" />
            </HorizontalStackLayout>
            <Label Text="Repuestos Utilizados:" FontAttributes="Bold" />
            <CollectionView x:Name="CvRepuestosAsignados" HeightRequest="110">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="5">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding TipoServicio, StringFormat='Tipo: {0}'}" FontAttributes="Bold" TextColor="#2563EB" />
                                <Label Text="{Binding FechaTurno, StringFormat='📅 Turno: {0:dd/MM/yyyy}'}" TextColor="#334155" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="0" Text="{Binding NombreRepuesto}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Cantidad, StringFormat='x{0}'}" Margin="10,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='${0:N2}'}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- el costo total  -->
            <Frame BackgroundColor="#FEF3C7" BorderColor="#F59E0B" CornerRadius="8">
                <Label x:Name="LblCostoTotal" FontSize="20" FontAttributes="Bold" TextColor="#B45309" HorizontalOptions="Center" />
            </Frame>
            <Button Text="Guardar Cambios" BackgroundColor="#2563EB" TextColor="White" HeightRequest="50" CornerRadius="8" Clicked="OnGuardarCambiosClicked" />
            <Button Text="Volver" BackgroundColor="Transparent" TextColor="Gray" Clicked="OnVolverClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>