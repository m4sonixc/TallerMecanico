<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TallerMecanico.Views.AdminTurnosActivosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Panel Administrador"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- bienvenida junto con el boton salir -->
        <Frame Grid.Row="0" BackgroundColor="#1E293B" Padding="20,15" CornerRadius="0" HasShadow="True">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label x:Name="LblBienvenidaAdmin" Text="Bienvenido, Administrador" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label Text="PachiTaller - Gestión Integral" FontSize="13" TextColor="#94A3B8" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Salir" BackgroundColor="#DC2626" TextColor="White" HeightRequest="36" CornerRadius="6" FontSize="12" Clicked="OnLogoutClicked" />
            </Grid>
        </Frame>

        <!-- aca esta el menu principal -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10" Margin="15,12,15,5">
            <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#F1F5F9" BorderColor="#2563EB" CornerRadius="12" Padding="10">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistorialTurnosClicked" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="📜" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Historial Turnos" FontAttributes="Bold" TextColor="#1E40AF" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#FEF3C7" BorderColor="#D97706" CornerRadius="12" Padding="10">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCatalogoRepuestosClicked" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="📦" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Catálogo Repuestos" FontAttributes="Bold" TextColor="#B45309" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#ECFDF5" BorderColor="#059669" CornerRadius="12" Padding="10">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVentaRepuestosClicked" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="🛒" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Venta Repuestos" FontAttributes="Bold" TextColor="#065F46" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#FAF5FF" BorderColor="#9333EA" CornerRadius="12" Padding="10">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBalanceClicked" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <Label Text="📊" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Balance Taller" FontAttributes="Bold" TextColor="#6B21A8" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
        <!-- buscador de turnos -->
        <SearchBar Grid.Row="2" x:Name="SbTurnos" Placeholder="Buscar por patente, auto o cliente..." Margin="15,6,15,4" TextChanged="OnBuscarTurnosChanged" />
        <!-- contenido desplegable -->
        <ScrollView Grid.Row="3" Margin="15,0,15,10">
            <VerticalStackLayout Spacing="10">
                <!-- aca estan los turnos solicitados -->
                <Frame BackgroundColor="#FFFBEB" BorderColor="#F59E0B" CornerRadius="10" Padding="12">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleSolicitadosClicked" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Label Grid.Column="0" Text="⏳ Turnos Solicitados (Por Aceptar)" FontAttributes="Bold" FontSize="15" TextColor="#B45309" VerticalOptions="Center" />
                        <Frame Grid.Column="1" BackgroundColor="#F59E0B" Padding="8,2" CornerRadius="10" VerticalOptions="Center" Margin="5,0">
                            <Label x:Name="LblCountSolicitados" Text="0" TextColor="White" FontAttributes="Bold" FontSize="12" />
                        </Frame>
                        <Label Grid.Column="2" x:Name="LblFlechaSolicitados" Text="▼" TextColor="#B45309" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <VerticalStackLayout x:Name="PanelSolicitados" IsVisible="True" Spacing="6">
                    <CollectionView x:Name="CvSolicitados" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No hay turnos pendientes de aceptación." TextColor="Gray" HorizontalOptions="Center" Margin="0,5" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,4" Padding="12" BorderColor="#FDE68A" BackgroundColor="#FFFDF7" CornerRadius="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Frame BackgroundColor="#1E293B" Padding="7,3" CornerRadius="5" HasShadow="False" VerticalOptions="Center">
                                                    <Label Text="{Binding Patente}" TextColor="White" FontAttributes="Bold" FontSize="11" />
                                                </Frame>
                                                <Label Text="{Binding MarcaVehiculo}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                                <Label Text="{Binding ModeloVehiculo}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Frame Grid.Column="1" BackgroundColor="#FEF3C7" BorderColor="#F59E0B" Padding="8,3" CornerRadius="6" VerticalOptions="Center" HasShadow="False">
                                                <Label Text="{Binding Estado}" FontAttributes="Bold" FontSize="12" TextColor="#B45309" />
                                            </Frame>
                                        </Grid>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding TipoServicio, StringFormat='Tipo: {0}'}" FontAttributes="Bold" TextColor="#0F766E" />
                                            <Label Text="{Binding FechaTurno, StringFormat='📅 Fecha solicitada: {0:dd/MM/yyyy}'}" TextColor="#334155" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}" TextColor="#475569" />
                                        <Label Text="{Binding TelefonoCliente, StringFormat='Teléfono: {0}'}" TextColor="#475569" />
                                        <Label Text="{Binding Problema, StringFormat='Motivo: {0}'}" LineBreakMode="WordWrap" />

                                        <Button Text="Revisar y Aceptar Turno" Margin="0,5,0,0" BackgroundColor="#D97706" TextColor="White" HeightRequest="38" CornerRadius="6"
                                                Clicked="OnGestionarTurnoClicked" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <!-- turnos activos en el taller -->
                <Frame BackgroundColor="#EFF6FF" BorderColor="#3B82F6" CornerRadius="10" Padding="12" Margin="0,5,0,0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleActivosClicked" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Label Grid.Column="0" Text="🚗 Turnos Activos (En Taller)" FontAttributes="Bold" FontSize="15" TextColor="#1E40AF" VerticalOptions="Center" />
                        <Frame Grid.Column="1" BackgroundColor="#2563EB" Padding="8,2" CornerRadius="10" VerticalOptions="Center" Margin="5,0">
                            <Label x:Name="LblCountActivos" Text="0" TextColor="White" FontAttributes="Bold" FontSize="12" />
                        </Frame>
                        <Label Grid.Column="2" x:Name="LblFlechaActivos" Text="▼" TextColor="#1E40AF" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <VerticalStackLayout x:Name="PanelActivos" IsVisible="True" Spacing="6">
                    <CollectionView x:Name="CvActivos" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No hay vehículos en proceso actualmente." TextColor="Gray" HorizontalOptions="Center" Margin="0,5" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,4" Padding="12" BorderColor="#CBD5E1" CornerRadius="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Frame BackgroundColor="#1E293B" Padding="7,3" CornerRadius="5" HasShadow="False" VerticalOptions="Center">
                                                    <Label Text="{Binding Patente}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                                </Frame>
                                                <Label Text="{Binding MarcaVehiculo}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                                <Label Text="{Binding ModeloVehiculo}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Frame Grid.Column="1" BackgroundColor="#EFF6FF" BorderColor="#93C5FD" Padding="8,3" CornerRadius="6" VerticalOptions="Center" HasShadow="False">
                                                <Label Text="{Binding Estado}" FontAttributes="Bold" FontSize="12" TextColor="#1E40AF" />
                                            </Frame>
                                        </Grid>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding TipoServicio, StringFormat='Tipo: {0}'}" FontAttributes="Bold" TextColor="#2563EB" />
                                            <Label Text="{Binding FechaTurno, StringFormat='📅 Fecha: {0:dd/MM/yyyy}'}" TextColor="#334155" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}" TextColor="#475569" />
                                        <Label Text="{Binding TelefonoCliente, StringFormat='Teléfono: {0}'}" TextColor="#475569" />
                                        <Label Text="{Binding Problema, StringFormat='Problema: {0}'}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Diagnostico, StringFormat='Diagnóstico: {0}'}" TextColor="#334155" FontAttributes="Italic" />
                                        <Label Text="{Binding CostoTotal, StringFormat='Costo Total: ${0:N2}'}" FontAttributes="Bold" TextColor="#16A34A" />
                                        <Button Text="Gestionar Turno" Margin="0,5,0,0" BackgroundColor="#2563EB" TextColor="White" HeightRequest="38" CornerRadius="6"
                                               Clicked="OnGestionarTurnoClicked" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>